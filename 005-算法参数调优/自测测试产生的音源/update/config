setenv pdtmodel DE2603
setenv bootdelay 0
setenv blkdevparts 'mtdparts=rk29xxnand:512K(loader),512K(uboot),512K(env),4096K(boot),8192K(rootfs),19456K(appfs),25600K(resfs),5120K(usrcfg),1024K(logo)'
setenv bootcmd 'boot_fit;boot_android ${devtype} ${devnum}'
setenv bootargs 'rootwait ubi.mtd=rootfs ubi.block=0,0 root=/dev/ubiblock0_0 rootfstype=squashfs ro mtdparts=rk29xxnand:512K(loader),512K(uboot),512K(env),4096K(boot),8192K(rootfs),19456K(appfs),25600K(resfs),5120K(usrcfg),1024K(logo)'
setenv sys_bootargs 'rk_dma_heap_cma=32M'
setenv ddppart 'loader:b,uboot:b,kernel:b,fs:b,appfs:b,resfs:b,usrcfg:b,logo:b'
setenv devtype mtd
setenv loadloader 'fatload mmc 0:%d 0x%x update/loader'
setenv loaduboot 'fatload mmc 0:%d 0x%x update/uboot'
setenv loadkernel 'fatload mmc 0:%d 0x%x update/kernel'
setenv loadfs 'fatload mmc 0:%d 0x%x update/rootfs'
setenv loadappfs 'fatload mmc 0:%d 0x%x update/appfs'
setenv loadresfs 'fatload mmc 0:%d 0x%x update/resfs'
setenv loadusrcfg 'fatload mmc 0:%d 0x%x update/usrcfg'
setenv loadlogo 'fatload mmc 0:%d 0x%x update/logo'
setenv eraseloader 'mtd erase spi-nand0 0x00000 0x80000'
setenv eraseuboot 'mtd erase spi-nand0 0x80000 0x80000'
setenv erasekernel 'mtd erase spi-nand0 0x180000 0x400000'
setenv erasefs 'mtd erase spi-nand0 0x580000 0x800000'
setenv eraseappfs 'mtd erase spi-nand0 0xd80000 0x1300000'
setenv eraseresfs 'mtd erase spi-nand0 0x2080000 0x1900000'
setenv eraseusrcfg 'mtd erase spi-nand0 0x3980000 0x500000'
setenv eraselogo 'mtd erase spi-nand0 0x3e80000 0x100000'
setenv upgloader 'mtd write spi-nand0 0x%x 0x00000 0x%x'
setenv upguboot 'mtd write spi-nand0 0x%x 0x80000 0x%x'
setenv upgkernel 'mtd write spi-nand0 0x%x 0x180000 0x%x'
setenv upgfs 'mtd write spi-nand0 0x%x 0x580000 0x%x'
setenv upgappfs 'mtd write spi-nand0 0x%x 0xd80000 0x%x'
setenv upgresfs 'mtd write spi-nand0 0x%x 0x2080000 0x%x'
setenv upgusrcfg 'mtd write spi-nand0 0x%x 0x3980000 0x%x'
setenv upglogo 'mtd write spi-nand0 0x%x 0x3e80000 0x%x'
saveenv
END
